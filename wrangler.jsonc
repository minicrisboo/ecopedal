{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "ecopedal",
  "main": "functions/api/[[path]].js",
  "compatibility_date": "2026-10-22",
  "assets": {
    "directory": "./_site",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/health"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ecopedal-db",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}